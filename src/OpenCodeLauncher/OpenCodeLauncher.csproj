<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <Content Include="opencode-logo-alstrive.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenCodeLauncher.Core\OpenCodeLauncher.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>opencode-logo-alstrive.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>OpenCodeLauncher</Product>
    <Description>Лаунчер для управления OpenCode-сервером</Description>
    <Copyright>Copyright (c) 2026 TagirovAlex</Copyright>
  </PropertyGroup>

</Project>